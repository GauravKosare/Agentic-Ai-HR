# Copy to .env.local (git-ignored) for a local override, or set in the host's
# env for a deployed build. Vite only exposes vars prefixed with VITE_.

# Backend origin. Leave unset in dev — vite.config.ts proxies /api to
# http://localhost:8000 so requests are same-origin. Set this for a deployed
# frontend pointing at a deployed backend (Cloud Run / Render).
# VITE_API_BASE_URL=https://your-backend.example.com

# --- Supabase Auth (not wired up yet — for the auth layer that comes next) ---
# Use the new publishable key (sb_publishable_...), NOT the secret key. The
# secret key must never reach the browser.
# VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=
