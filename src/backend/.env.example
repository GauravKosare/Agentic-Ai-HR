# Copy this file to .env and fill in real values there.
# .env is git-ignored — never commit real secrets. Never paste real values into chat either.

# --- Supabase ---
# Project Settings -> API Keys in your Supabase dashboard. Use the NEW key format
# (sb_secret_.../sb_publishable_...), not the legacy anon/service_role JWTs —
# same permissions, but each key rotates independently. Legacy keys are being
# deprecated by end of 2026.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Secret key" (sb_secret_...) — full access, bypasses Row Level Security. Backend/orchestrator only, never the frontend.
SUPABASE_SECRET_KEY=
# "Publishable key" (sb_publishable_...) — subject to RLS. Optional for now; only needed once something does RLS-scoped/frontend-style access.
SUPABASE_PUBLISHABLE_KEY=

# --- LLM Router (TRD §3.1a) — Gemini primary, Groq fallback ---
# Each *_MODELS_* value is a comma-separated CHAIN: the router tries each model in
# order, moving to the next one in the same chain on a quota (429) error before
# ever switching provider. Picked from live account quota data (Google AI Studio /
# Groq console) as of 2026-07-20 — free-tier per-model limits vary by account and
# change over time; re-check yours in each dashboard rather than trusting this file.
#
# Google AI Studio (aistudio.google.com) -> Get API key. Leave billing DISABLED on the
# project or the free tier disappears (07-Financial-Subscription-Tracking.md).
GEMINI_API_KEY=
# Reasoning: two Gemini Flash models, each with its own small daily quota (~20
# RPD each on a typical account) — chaining doubles the daily budget before Groq.
GEMINI_MODELS_REASONING=gemini-3.5-flash,gemini-3-flash
# Light: gemini-3.1-flash-lite (~500 RPD) then Gemma open-weight models via the
# same API (~14.4K RPD each) — a large free reserve for high-volume tasks.
GEMINI_MODELS_LIGHT=gemini-3.1-flash-lite,gemma-4-26b,gemma-4-31b

# console.groq.com -> API Keys. No card required, no expiry on the free tier.
# NOT the same company as xAI's "Grok" (x.ai) — that's a different, paid service
# with no real free tier. Groq keys don't have an "xai-" prefix.
GROQ_API_KEY=
# Reasoning: gpt-oss-120b (~1K RPD) then llama-3.3-70b-versatile and
# qwen3.6-27b, each adding another ~1K RPD once the previous one is exhausted.
GROQ_MODELS_REASONING=openai/gpt-oss-120b,llama-3.3-70b-versatile,qwen/qwen3.6-27b
# Light: gpt-oss-20b (~1K RPD) then llama-3.1-8b-instant — by far the most
# generous single free-tier model available (~14.4K RPD), saved for last.
GROQ_MODELS_LIGHT=openai/gpt-oss-20b,llama-3.1-8b-instant

# --- Speech-to-Text (TRD §3.7) ---
# Groq-hosted Whisper (not self-hosted) — LPU-accelerated, free, avoids the
# latency risk of CPU-only self-hosted inference. turbo first (faster, better fit
# for the ~1s real-time target), large-v3 second (marginally more accurate,
# separate quota bucket so chaining ~doubles the daily audio budget). Uses the
# same GROQ_API_KEY above.
GROQ_MODELS_STT=whisper-large-v3-turbo,whisper-large-v3
