# Copy to .env and fill in. Never commit .env.

# Self-hosted LiveKit (docker-compose.yml dev values shown — change before any non-spike use)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret9999999999999999999999

# Same free-tier keys already used by src/backend — this spike imports those connectors
# directly rather than re-implementing key handling.
GROQ_API_KEY=
GEMINI_API_KEY=

# Which language this run's interview script/voices use — edit per test session
# (docs/spikes/phase5-voice-spike.md days 7-8). One of: en, hi, mr.
SPIKE_LANGUAGE=en

# Paths to downloaded Piper .onnx voice models (README step 3 — python -m
# piper.download_voices <name> --data-dir voices/). Marathi is deliberately left blank for
# now — see README "Marathi, deferred" — pick a voice up before days 7-8.
PIPER_VOICE_EN_PATH=voices/en_US-lessac-medium.onnx
PIPER_VOICE_HI_PATH=voices/hi_IN-pratham-medium.onnx
PIPER_VOICE_MR_PATH=
