# Copy to .env and fill in. Never commit .env.

# Self-hosted LiveKit (docker-compose.yml dev values shown — change before any non-spike use)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret9999999999999999999999

# Same free-tier keys already used by src/backend — this spike imports those connectors
# directly rather than re-implementing key handling.
GROQ_API_KEY=
GEMINI_API_KEY=

# Path to Piper voice models downloaded per README step 3.
PIPER_VOICE_EN=en_US-lessac-medium
PIPER_VOICE_HI=hi_IN-pratham-medium
PIPER_VOICE_MR=
